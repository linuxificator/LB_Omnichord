#!/bin/bash
set -e

APP_DIR="${OMNICHORD_DIR:-$HOME/LB_Omnichord/amysynth_version/qt_frontend}"
SERIAL_PORT="${OMNICHORD_SERIAL_PORT:-/dev/serial0}"
SERIAL_BAUD="${OMNICHORD_SERIAL_BAUD:-1000000}"

for i in $(seq 1 30); do
    [ -e "$SERIAL_PORT" ] && break
    sleep 1
done

cd "$APP_DIR"

if [ -x "$APP_DIR/.venv/bin/python" ]; then
    PYTHON="$APP_DIR/.venv/bin/python"
elif [ -x "$HOME/omnichord-env/bin/python" ]; then
    PYTHON="$HOME/omnichord-env/bin/python"
else
    PYTHON=python3
fi

exec "$PYTHON" ./code/main.py --fullscreen --serial-port "$SERIAL_PORT" --serial-baud "$SERIAL_BAUD"
