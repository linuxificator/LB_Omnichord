{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LB Omnichord bass riff catalogue v1",
  "type": "object",
  "required": ["schema_version", "scale_vocabulary", "rhythm_types", "chord_types", "riffs"],
  "properties": {
    "schema_version": {"const": 1},
    "scale_vocabulary": {"$ref": "#/$defs/idRows"},
    "rhythm_types": {"$ref": "#/$defs/idRows"},
    "chord_types": {"$ref": "#/$defs/idRows"},
    "riffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "riff_id", "normalized_root", "normalized_anchor_midi", "compatible_rhythms", "compatible_chords", "compatible_scales", "timing"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "riff_id": {"type": "string", "minLength": 1},
          "normalized_root": {"const": "C"},
          "normalized_anchor_midi": {"const": 36},
          "compatible_rhythms": {"$ref": "#/$defs/nonEmptyStrings"},
          "compatible_chords": {"$ref": "#/$defs/nonEmptyStrings"},
          "compatible_scales": {"$ref": "#/$defs/nonEmptyStrings"},
          "timing": {
            "type": "object",
            "required": ["ppq", "phrase_ticks", "events"],
            "properties": {
              "ppq": {"type": "integer", "minimum": 1},
              "phrase_ticks": {"type": "integer", "minimum": 1},
              "events": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["tick", "duration_ticks", "pitch_offset_semitones_from_C2", "velocity"],
                  "properties": {
                    "tick": {"type": "integer", "minimum": 0},
                    "duration_ticks": {"type": "integer", "minimum": 1},
                    "pitch_offset_semitones_from_C2": {"type": "integer"},
                    "velocity": {"type": "integer", "minimum": 0, "maximum": 127}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "idRows": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}}
    },
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
