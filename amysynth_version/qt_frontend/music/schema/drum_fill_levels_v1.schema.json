{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "global_gain", "per_fill"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "global_gain": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
    "per_fill": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 2
      }
    }
  }
}
