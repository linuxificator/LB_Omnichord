{
  "fullscreen": {
    "button_fullscreen_text": "ESC",
    "button_windowed_text": "FSC",
    "uses_showNormal": true,
    "uses_showFullScreen": true,
    "explicit_decorated_window_flags": true
  },
  "watermarks": {
    "opacity": 0.72,
    "tuba_source": "user supplied tuba drawing",
    "tuba_asset": "tuba_watermark.png",
