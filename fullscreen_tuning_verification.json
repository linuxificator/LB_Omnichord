    "formula": "12 * log2(reference / 440)",
    "qt_side_only": true,
    "strum_precision_decimal_places": 12,
    "sonic_pi_note_parsing": "to_f",
    "preset_field": "tuning.reference_hz",
    "numeric_checks": {
      "A440_offset": 0.0,
      "A442_offset": 0.07851415040126504,
      "A415_offset": -1.012706247484469,
      "A466_offset": 0.9939171735554475
    }
  },
  "ruby_syntax": "Syntax OK"
}
