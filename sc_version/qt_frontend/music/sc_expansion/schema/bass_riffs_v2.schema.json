{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SC capability-driven bass riffs v2",
  "type": "object",
  "required": ["schema_version", "extension_version", "scale_vocabulary", "rhythm_types", "chord_types", "riffs"],
  "properties": {
    "schema_version": {"const": 2},
    "extension_version": {"type": "integer", "minimum": 1},
    "scale_vocabulary": {"$ref": "#/$defs/idRows"},
    "rhythm_types": {"$ref": "#/$defs/idRows"},
    "chord_types": {"$ref": "#/$defs/idRows"},
    "riffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "riff_id", "normalized_root", "normalized_anchor_midi", "compatible_scales", "compatible_chords", "compatible_rhythms", "activity_rank", "selection_weight", "timing"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "riff_id": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "normalized_root": {"const": "C"},
          "normalized_anchor_midi": {"const": 36},
          "compatible_scales": {"$ref": "#/$defs/nonEmptyStrings"},
          "compatible_chords": {"$ref": "#/$defs/nonEmptyStrings"},
          "compatible_rhythms": {"$ref": "#/$defs/nonEmptyStrings"},
          "activity_rank": {"type": "integer", "minimum": 1, "maximum": 5},
          "selection_weight": {"type": "integer", "minimum": 1},
          "timing": {
            "type": "object",
            "required": ["ppq", "phrase_ticks", "events"],
            "properties": {
              "ppq": {"const": 96},
              "phrase_ticks": {"type": "integer", "minimum": 1},
              "events": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["tick", "duration_ticks", "pitch_offset_semitones_from_C2", "role", "velocity", "accent", "slide_to_next", "link_to_next", "gate_policy", "accent_amount"],
                  "properties": {
                    "role": {"type": "string", "minLength": 1},
                    "tick": {"type": "integer", "minimum": 0},
                    "duration_ticks": {"type": "integer", "minimum": 1},
                    "pitch_offset_semitones_from_C2": {"type": "integer"},
                    "velocity": {"type": "integer", "minimum": 0, "maximum": 127},
                    "accent": {"type": "boolean"},
                    "slide_to_next": {"type": "boolean"},
                    "link_to_next": {"enum": ["none", "tie", "legato_glide"]},
                    "gate_policy": {"type": "string", "minLength": 1},
                    "accent_amount": {"type": "number", "minimum": 0, "maximum": 1},
                    "glide_time_ms": {"type": "number", "minimum": 0},
                    "link_target_index": {"type": "integer", "minimum": 0},
                    "link_target_cycle_offset": {"type": "integer", "minimum": 0, "maximum": 1},
                    "fallback": {
                      "type": "object",
                      "required": ["duration_ticks", "retrigger_next", "glide"],
                      "properties": {
                        "duration_ticks": {"type": "integer", "minimum": 1},
                        "retrigger_next": {"type": "boolean"},
                        "glide": {"type": "boolean"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "idRows": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}}},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
