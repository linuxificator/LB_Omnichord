{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared riff catalogue v1 layout with rank and 303 articulation",
  "type": "object",
  "required": [
    "schema_version",
    "scale_vocabulary",
    "rhythm_types",
    "chord_types",
    "riffs",
    "extension_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scale_vocabulary": {
      "$ref": "#/$defs/idRows"
    },
    "rhythm_types": {
      "$ref": "#/$defs/idRows"
    },
    "chord_types": {
      "$ref": "#/$defs/idRows"
    },
    "riffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "riff_id",
          "normalized_root",
          "normalized_anchor_midi",
          "compatible_rhythms",
          "compatible_chords",
          "compatible_scales",
          "timing",
          "activity_rank",
          "selection_weight",
          "tb303",
          "source_refs"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "riff_id": {
            "type": "string",
            "minLength": 1
          },
          "normalized_root": {
            "const": "C"
          },
          "normalized_anchor_midi": {
            "const": 36
          },
          "compatible_rhythms": {
            "$ref": "#/$defs/nonEmptyStrings"
          },
          "compatible_chords": {
            "$ref": "#/$defs/nonEmptyStrings"
          },
          "compatible_scales": {
            "$ref": "#/$defs/nonEmptyStrings"
          },
          "timing": {
            "type": "object",
            "required": [
              "ppq",
              "phrase_ticks",
              "events"
            ],
            "properties": {
              "ppq": {
                "type": "integer",
                "minimum": 1
              },
              "phrase_ticks": {
                "type": "integer",
                "minimum": 1
              },
              "events": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "tick",
                    "duration_ticks",
                    "pitch_offset_semitones_from_C2",
                    "velocity",
                    "accent",
                    "slide_to_next",
                    "role"
                  ],
                  "properties": {
                    "tick": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "duration_ticks": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "pitch_offset_semitones_from_C2": {
                      "type": "integer"
                    },
                    "velocity": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 127
                    },
                    "accent": {
                      "type": "boolean"
                    },
                    "slide_to_next": {
                      "type": "boolean"
                    },
                    "role": {
                      "enum": [
                        "chord_tone",
                        "scale_colour",
                        "chromatic_approach"
                      ]
                    }
                  }
                }
              }
            }
          },
          "activity_rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "selection_weight": {
            "type": "integer",
            "minimum": 1
          },
          "tb303": {
            "type": "object",
            "required": [
              "articulation_profile",
              "slide_semantics",
              "ordinary_synth_policy"
            ],
            "properties": {
              "articulation_profile": {
                "const": "accent_slide_v1"
              },
              "slide_semantics": {
                "const": "at_next_onset_no_retrigger"
              },
              "ordinary_synth_policy": {
                "const": "use_original_duration_and_velocity_ignore_303_flags"
              }
            }
          }
        }
      }
    },
    "extension_version": {
      "const": 3
    }
  },
  "$defs": {
    "idRows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
